{
  "schema_version": 1,
  "name": "claude-hardened",
  "version": "0.1.0",
  "description": "Hardened nono profile for Claude Code, based on the nolabs-ai/claude profile.",
  "license": "Apache-2.0",
  "platforms": [
    "macos"
  ],
  "min_nono_version": "0.81.0",
  "artifacts": [
    {
      "type": "profile",
